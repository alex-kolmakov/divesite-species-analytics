# Server block for divediversity.app, to add to the nginx that already serves the other site on
# this machine. That nginx's container has to be on the `web` Docker network too:
#
#   services:
#     nginx:
#       networks: [default, web]
#   networks:
#     web:
#       external: true
#
# Certificate paths are placeholders: use the same setup as the existing site, for this hostname.

server {
    listen 80;
    server_name divediversity.app www.divediversity.app;
    return 301 https://divediversity.app$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name divediversity.app;

    ssl_certificate     /etc/nginx/certs/divediversity.app.pem;
    ssl_certificate_key /etc/nginx/certs/divediversity.app.key;

    # Resolve the app's name per request, so nginx still starts while the app is down
    resolver 127.0.0.11 valid=30s;
    set $divesite http://divediversity-app-1:8080;

    location / {
        proxy_pass $divesite;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
